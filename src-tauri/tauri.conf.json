{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaisaPilot",
  "version": "1.0.0",
  "identifier": "com.paisapilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "PaisaPilot",
      "width": 1280,
      "height": 850,
      "minWidth": 740,
      "minHeight": 600
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Private, local-first expense tracking",
    "category": "Finance"
  }
}
