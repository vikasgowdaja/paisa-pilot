# Copy this file to `.env` at the repository root (never commit `.env`).
# Read by src-tauri/build.rs at build time and used for the Windows build only.
# Use the Client ID and Secret of a Google OAuth "Desktop app" client.
PAISAPILOT_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
PAISAPILOT_GOOGLE_CLIENT_SECRET=

# Android release signing is NOT configured here. Gradle reads these from real
# environment variables, so set them in your shell (or CI secrets) instead:
#   PAISAPILOT_ANDROID_KEYSTORE, PAISAPILOT_ANDROID_KEYSTORE_PASSWORD,
#   PAISAPILOT_ANDROID_KEY_ALIAS
#
# Example (PowerShell, current session only; never put real values in this file):
#   $env:PAISAPILOT_ANDROID_KEYSTORE = "C:\path\to\release.jks"
#   $env:PAISAPILOT_ANDROID_KEYSTORE_PASSWORD = "<keystore password>"
#   $env:PAISAPILOT_ANDROID_KEY_ALIAS = "paisapilot"